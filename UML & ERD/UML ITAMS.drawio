        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Definisi Style agar terlihat profesional\n    classDef actor fill:#e1f5fe,stroke:#01579b,stroke-width:2px;\n    classDef system fill:#fff3e0,stroke:#e65100,stroke-width:2px;\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    classDef endState fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,rx:10,ry:10;\n\n    Start((Mulai)) --&gt; A[Karyawan: Ajukan Peminjaman Aset]:::actor\n    A --&gt; B{Sistem: Cek Status Aset == &#39;Available&#39;?}:::system\n    \n    B -- Tidak --&gt; C[Sistem: Tolak &amp; Return Error 400]:::system\n    C --&gt; End1((Selesai)):::endState\n    \n    B -- Ya --&gt; D[Sistem: Buat record &#39;borrowings&#39; status = &#39;Pending&#39;]:::system\n    D --&gt; E{Sistem: Apakah Aset Bernilai Tinggi?}:::decision\n    \n    E -- Ya --&gt; F[Manajemen: Review &amp; Approve/Reject]:::actor\n    F --&gt; G{Keputusan Manajemen?}:::decision\n    G -- Reject --&gt; H[Sistem: Update status = &#39;Rejected&#39;]:::system\n    H --&gt; End2((Selesai)):::endState\n    \n    E -- Tidak --&gt; I[Staff Inventaris: Siapkan Fisik Aset]:::actor\n    G -- Approve --&gt; I\n    \n    I --&gt; J[Staff: Klik &#39;Serahkan Aset&#39;]:::actor\n    J --&gt; K[Sistem: DB TRANSACTION&lt;br/&gt;1. Update borrowings = &#39;Borrowed&#39;&lt;br/&gt;2. Update assets = &#39;Borrowed&#39;]:::system\n    \n    K --&gt; L[Karyawan: Gunakan Aset]:::actor\n    L --&gt; M[Karyawan: Ajukan Pengembalian]:::actor\n    M --&gt; N[Sistem: Update borrowings = &#39;Returning&#39;]:::system\n    \n    N --&gt; O[Teknisi: Verifikasi Kondisi Fisik Aset]:::actor\n    O --&gt; P{Sistem: Kondisi Aset?}:::decision\n    \n    P -- Baik --&gt; Q[Sistem: Update assets = &#39;Available&#39;&lt;br/&gt;Update borrowings = &#39;Done&#39;]:::system\n    Q --&gt; End3((Selesai)):::endState\n    \n    P -- Rusak --&gt; R[Sistem: Update assets = &#39;Maintenance&#39;&lt;br/&gt;Buat record baru di